# Copy to .env for local development. Never commit .env.
# Public values only: the Supabase anon key is safe in the browser because Row Level Security protects the data.
# NEVER put the service_role key here or anywhere in this repository.

PUBLIC_SUPABASE_URL=
PUBLIC_SUPABASE_ANON_KEY=
PUBLIC_GOOGLE_LOGIN=false

# Demo mode keeps all data in the visitor's browser with the fixed code 123456.
# Local development only: it runs on localhost only, the build refuses it on Vercel (production and preview),
# and it cannot be combined with PUBLIC_SUPABASE_URL. Leave it unset everywhere else.
PUBLIC_DEMO_MODE=false
