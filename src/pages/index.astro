---
// Scaffold placeholder (Phase 4, step 1). It proves the token and font pipeline works.
// The real homepage replaces it in step 4.
import BaseLayout from '../layouts/BaseLayout.astro';
---
<BaseLayout title="Dara in Tech" description="A community for women to learn, connect, and grow in tech.">
  <main style="padding: var(--space-5) var(--space-2); background: var(--bg-page); color: var(--text-body); font-family: var(--font-body);">
    <h1 style="font-family: var(--font-display); color: var(--text-headline); letter-spacing: var(--tracking-display); margin: 0;">Hi, we’re Dara in Tech</h1>
    <p>A community for women to learn, connect, and grow in tech.</p>
  </main>
</BaseLayout>
