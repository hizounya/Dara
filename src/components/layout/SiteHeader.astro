---
// Shared site header: logo, main navigation, theme toggle, Member login and the main call to action.
// Below 960px the links move into a disclosure menu (button with aria-expanded; Escape closes it).
// Without JavaScript the menu simply stays open, so every link is still reachable.
// Styles live in components.css (.dit-hdr) because the Member Hub renders the same header.
import Logo from '../brand/Logo.astro';
import Button from '../content/Button.astro';
import ThemeToggle from './ThemeToggle.astro';
import { site } from '../../data/site';
---
<header class="dit-hdr">
  <div class="dit-container dit-hdr__bar">
    <a class="dit-hdr__logo" href="/" aria-label="Dara in Tech home"><Logo height={40} /></a>

    <div class="dit-hdr__actions">
      <ThemeToggle />
      <button class="dit-hdr__menu-btn" type="button" aria-expanded="false" aria-controls="site-menu" data-nav-toggle>
        <svg class="dit-icon" viewBox="0 0 20 20" aria-hidden="true"><path class="dit-hdr__burger" d="M3 6h14M3 10h14M3 14h14" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" /></svg>
        <span>Menu</span>
      </button>
    </div>

    <nav class="dit-hdr__menu" id="site-menu" aria-label="Main">
      <ul class="dit-hdr__links">
        {site.nav.map((item) => <li><a href={item.href}>{item.label}</a></li>)}
      </ul>
      <div class="dit-hdr__ctas">
        <Button href={site.hubUrl} variant="ghost" size="sm">Member login</Button>
        <Button href={site.joinUrl} size="sm">Join our community<span class="dit-visually-hidden"> on {site.joinVia}</span></Button>
      </div>
    </nav>
  </div>
</header>

<script>
  const button = document.querySelector<HTMLButtonElement>('[data-nav-toggle]');
  const menu = document.getElementById('site-menu');
  if (button && menu) {
    const setOpen = (open: boolean) => {
      button.setAttribute('aria-expanded', String(open));
      menu.dataset.open = String(open);
      document.body.classList.toggle('dit-menu-open', open);
    };
    button.addEventListener('click', () => {
      const open = button.getAttribute('aria-expanded') !== 'true';
      setOpen(open);
      if (open) menu.querySelector('a')?.focus();
    });
    menu.addEventListener('click', (e) => { if ((e.target as Element).closest('a')) setOpen(false); });
    document.addEventListener('keydown', (e) => {
      if (e.key === 'Escape' && button.getAttribute('aria-expanded') === 'true') { setOpen(false); button.focus(); }
    });
    matchMedia('(min-width: 960px)').addEventListener('change', (e) => { if (e.matches) setOpen(false); });
  }
</script>
