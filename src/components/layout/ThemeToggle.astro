---
// Light/dark switch. A toggle button: the label stays "Dark mode" and aria-pressed says whether it is on.
// Behaviour comes from ThemeInit (event delegation), so this component ships no JavaScript of its own.
---
<button type="button" class="dit-theme-toggle" data-theme-toggle aria-pressed="false" aria-label="Dark mode" title="Light / dark mode">
  <svg class="dit-icon i-moon" viewBox="0 0 16 16" aria-hidden="true"><path d="M13.6 10.3A6 6 0 0 1 5.7 2.4a6 6 0 1 0 7.9 7.9z" /></svg>
  <svg class="dit-icon i-sun" viewBox="0 0 16 16" aria-hidden="true"><circle cx="8" cy="8" r="3.2" /><path d="M8 .8v2.1M8 13.1v2.1M.8 8h2.1M13.1 8h2.1M2.9 2.9l1.5 1.5M11.6 11.6l1.5 1.5M2.9 13.1l1.5-1.5M11.6 4.4l1.5-1.5" fill="none" stroke="currentColor" stroke-width="1.6" stroke-linecap="round" /></svg>
</button>
