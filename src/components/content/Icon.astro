---
// Inline SVG icon from src/assets/icons (Font Awesome Free, see ATTRIBUTION.md). Inherits currentColor.
// Decorative by default; pass `label` when the icon carries meaning on its own.
const files = import.meta.glob('../../assets/icons/*.svg', { query: '?raw', import: 'default', eager: true }) as Record<string, string>;

export type IconName = 'arrow-right' | 'book-open' | 'briefcase' | 'bullhorn' | 'calendar-days' | 'comments' | 'graduation-cap'
  | 'handshake' | 'heart' | 'heart-outline' | 'laptop-code' | 'lightbulb' | 'location-dot' | 'rocket' | 'screwdriver-wrench' | 'star' | 'users';

interface Props { name: IconName; label?: string; class?: string; }
const { name, label, class: cls } = Astro.props;

const svg = files[`../../assets/icons/${name}.svg`];
if (!svg) throw new Error(`Icon "${name}" not found in src/assets/icons`);
const viewBox = svg.match(/viewBox="([^"]+)"/)?.[1];
const inner = svg.replace(/^[\s\S]*?<svg[^>]*>/, '').replace(/<\/svg>\s*$/, '');
---
<svg class:list={['dit-icon', cls]} viewBox={viewBox} aria-hidden={label ? undefined : 'true'} role={label ? 'img' : undefined} aria-label={label} set:html={inner} />
